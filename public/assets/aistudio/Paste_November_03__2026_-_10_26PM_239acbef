            0.361,
            0.269,
            0.594,
            0.304
          ],
          "content": "Q = ( m _ { o } + \\mu _ { o } ) c _ { o } ( \\theta _ { f } - \\theta _ { o } ) ,",
          "image_source": "images/page_9_equation_2.jpg"
        },
        {
          "type": "text",
          "bbox": [
            0.212,
            0.316,
            0.788,
            0.362
          ],
          "content": "L’énergie électrique dissipée dans la résistance est donnée par la loi de"
        },
        {
          "type": "text",
          "bbox": [
            0.163,
            0.372,
            0.221,
            0.388
          ],
          "content": "Joule :"
        },
        {
          "type": "equation",
          "bbox": [
            0.371,
            0.373,
            0.588,
            0.415
          ],
          "content": "W_{e}=UI=RI^{2}t=\\frac{U^{2}}{R}t",
          "image_source": "images/page_9_equation_5.jpg"
        },
        {
          "type": "paragraph_title",
          "bbox": [
            0.23,
            0.452,
            0.432,
            0.474
          ],
          "level": 2,
          "content": "2. Etude expérimentale"
